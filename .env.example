NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_. Powers the live Google
# rating/review-count fetch in lib/google-reviews.ts (Places API, Place
# Details). Without it, profile pages fall back to each business's static
# reviewSnapshot (or a "no verified rating yet" message) — nothing crashes.
GOOGLE_PLACES_API_KEY=
